
def[12] y;
def[12] x;
def[12] f;
def[12] status;

y = 20;
x = 30;


while (y) {
    while (x) {
        f = (x) * (x);
        status = (f) == (y);

        if (status) {
            .output[16] << "X2";
        };

        status = (f) != (y);

        if (status) {
            .output[8] << " ";
        };

        x = (x) + (-1);
    };

    y = (y) + (-1);
    x = 30;

    .output[8] << "\n";
};